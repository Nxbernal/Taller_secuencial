Algoritmo Notas
	definir nota1, nota2, nota3, nota4, notasSumadas, notaFinal Como Real
	Escribir "Ingrese su primera nota "
	Leer nota1
	Escribir "Ingrese su segunda nota "
	Leer nota2
	Escribir "Ingrese su tercera nota "
	Leer nota3
	Escribir "Ingrese su cuarta nota "
	leer nota4
	notasSumadas= nota1 + nota2 + nota3 + nota4
	notaFinal= notasSumadas/4
	Escribir "Su nota final es ", notaFinal
	
FinAlgoritmo
