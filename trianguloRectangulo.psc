Algoritmo trianguloRectangulo
	Definir cateto1,cateto2,hipotenusa Como Real
	Escribir "Ingrese el valor del primer cateto"
	leer cateto1
	Escribir "Ingrese el valor del primer cateto"
	leer cateto2
	hipotenusa=(RAIZ(cateto1^2)+(cateto2^2))
	Imprimir "La hipotenusa de su triangulo rectangulo es de ", hipotenusa
FinAlgoritmo
