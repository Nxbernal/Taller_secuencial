Algoritmo Rectangulo
	definir base,altura,area,perimetro Como Real
	Escribir "Ingese la base del rectangulo "
	leer base
	Escribir "Ingese la altura del rectangulo "
	Leer altura
	area= base*altura
	perimetro= (2*base)+(2*altura)
	Imprimir "El area de su rectangulo es de ", area
	Imprimir "El perimetro de su rectangulo es de ", perimetro
FinAlgoritmo
