Algoritmo Funciones
	definir numeronum, seno, coseno, tangente Como Real
	definir raizz, lograitmoNatural, logaritmo10 Como Real
	Imprimir "Ingrese un numero"
	Leer numeronum
	seno= sen(numeronum)
	coseno= cos(numeronum)
	tangente= tan(numeronum)
	raizz= raiz(numeronum)
	lograitmoNatural= LN(numeronum)
	logaritmo10= ln(numeronum)/ln(10)
	Escribir "Del numero ", numeronum
	Escribir "Su seno es ", seno
	Escribir "Su coseno es ", coseno
	Escribir "Su tangente es ", tangente
	Escribir "Su raiz cuadrada es ", raizz
	Escribir "Su logaritmo natural es ", lograitmoNatural
	Escribir "Su logaritmo en base 10 es ", logaritmo10
FinAlgoritmo
