Algoritmo ejercicio9
	Definir centimetros,yardas,metros,pie1,pulgadas Como Real
	Escribir "Ingrese su valor en centimetros"
	leer centimetros
	pulgadas=centimetros/2.54
	metros=centimetros/100
	yardas=centimetros/91.44
	pie1=30.48
	pies=centimetros/pie1
	Imprimir "Su valor ingresado en pulgadas es ",pulgadas
	Imprimir "Su valor ingresado en metros es ",metros
	Imprimir "Su valor ingresado en yardas es ",yardas
	Imprimir "Su valor ingresado en pies es ",pies
FinAlgoritmo
