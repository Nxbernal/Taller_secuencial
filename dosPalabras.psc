Algoritmo dosPalabras
	definir palabraA,palabraB,palabraC Como Caracter
	Escribir "Ingrese una palabra"
	Leer palabraA
	palabraC=palabraA
	Escribir "Ingrese otra palabra"
	Leer palabraB
	palabraA=palabraB
	Imprimir "La primera palabra fue ",palabraA
	Imprimir "La segunda palabra fue ",palabraC
FinAlgoritmo
