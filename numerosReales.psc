Algoritmo numerosReales
	definir num1,num2,num3,promedio Como Real
	Escribir "Ingrese un numero real "
	leer num1
	Escribir "Ingrese un segundo numero real "
	leer num2
	Escribir "Ingrese un tercer numero real "
	leer num3
	promedio=(num1+num2+num3)/3
	Imprimir "El promedio aritmetico de sus tres numeros es de ", promedio
FinAlgoritmo
